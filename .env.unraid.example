# Compose Manager: keep your EXISTING secrets, LAN binding and persistence paths.
# This is a template, never replace working credentials with these placeholders.
# Approved pre-releases follow preview; approved stable releases follow latest.
CORE_IMAGE=ghcr.io/tmatz27/photography-events-core:preview
# For a deliberately pinned installation instead: ...:v0.1.0-rc.2
POSTGRES_ADMIN_PASSWORD=<keep-existing-admin-password>
POSTGRES_PASSWORD=<keep-existing-application-password>
CORE_API_TOKEN=<keep-existing-at-least-32-character-token>
# Keep your actual Unraid LAN IP. Example only; do not change an existing binding.
CORE_BIND_IP=192.168.1.132
CORE_PORT=8099
CORE_DATABASE_TIMEOUT=3
CORE_EVALUATION_GRACE=30
CORE_PATTERNS_MODE=shadow
CORE_PATTERN_TIMEOUT=30
CORE_LIVE_SOURCES=true
CORE_SOURCE_KEYS=all
CORE_RETENTION_ENABLED=false
CORE_SOURCE_USER_AGENT=PhotographyEventsCore-shadow (+https://github.com/Tmatz27/photography-events-core)
DB_DATA_PATH=/mnt/cache/appdata/photography-events-db
CORE_DATA_PATH=/mnt/cache/appdata/photography-events-core
BACKUP_DIR=<keep-existing-mounted-Synology-backup-directory>
CORE_EBIRD_API_KEY=
CORE_NPS_API_KEY=
CORE_PURPLEAIR_API_KEY=
CORE_SUNSETWX_CLIENT_ID=
CORE_SUNSETWX_CLIENT_SECRET=
CORE_COPERNICUS_CLIENT_ID=
CORE_COPERNICUS_CLIENT_SECRET=
CORE_MBARI_API_TOKEN=
CORE_IMAP_HOST=
CORE_IMAP_USERNAME=
CORE_IMAP_PASSWORD=

POSTGRES_ADMIN_PASSWORD=<generate-separate-admin-password>
POSTGRES_PASSWORD=<generate-application-password>
CORE_API_TOKEN=<generate-at-least-32-random-characters>
CORE_BIND_IP=127.0.0.1
CORE_PORT=8099
CORE_DATABASE_TIMEOUT=3
CORE_EVALUATION_GRACE=30
CORE_PATTERNS_MODE=off
CORE_PATTERN_TIMEOUT=30
CORE_LIVE_SOURCES=false
CORE_SOURCE_KEYS=inaturalist,wfigs_current,nws_live_context
# Opt-in hourly bounded raw-payload/run sweep; normalized history remains retained.
CORE_RETENTION_ENABLED=false
CORE_SOURCE_USER_AGENT=PhotographyEventsCore-shadow (+https://github.com/Tmatz27/photography-events-core)
DB_DATA_PATH=/mnt/cache/appdata/photography-events-db
CORE_DATA_PATH=/mnt/cache/appdata/photography-events-core
BACKUP_DIR=<mounted-Synology-backup-directory>

# Approved program credential slots. Empty values never certify collection.
# Adapter consumers below are scheduled batches, not implemented in Batch 1.
# Required for eBird notable and species (Batch 3).
CORE_EBIRD_API_KEY=
# Required for NPS alerts/access (Batch 2).
CORE_NPS_API_KEY=
# Required API key for PurpleAir; plan/storage rights still need validation (Batch 2).
CORE_PURPLEAIR_API_KEY=
# Required subscription client pair for SunsetWx Sunburst (Batch 2).
CORE_SUNSETWX_CLIENT_ID=
CORE_SUNSETWX_CLIENT_SECRET=
# Approved Sentinel-2 access path must be reconciled with Gemini handoff (Batch 5).
CORE_COPERNICUS_CLIENT_ID=
CORE_COPERNICUS_CLIENT_SECRET=
# MBARI token/access format is pending provider permission and approved contract (Batch 4).
CORE_MBARI_API_TOKEN=
# Required only for expressly subscribed legacy email ingress (Batch 3).
CORE_IMAP_HOST=
CORE_IMAP_USERNAME=
CORE_IMAP_PASSWORD=
# Public providers do not consume these keys. Never paste live values into evidence.
